diff --git a/discover/cann_test.go b/discover/cann_test.go
new file mode 100644
index 0000000..41c80ef
--- /dev/null
+++ b/discover/cann_test.go
@@ -0,0 +1,42 @@
+package discover
+
+import (
+	"path/filepath"
+	"runtime"
+	"testing"
+
+	"github.com/ollama/ollama/ml"
+)
+
+func TestCANNDeviceClassification(t *testing.T) {
+	for _, name := range []string{"CANN0", "CANN1"} {
+		if got := inferLibrary(name, "Ascend910B4"); got != "CANN" {
+			t.Fatalf("%s classified as %s", name, got)
+		}
+	}
+	if got := inferLibrary("CUDA0", "NVIDIA"); got != "CUDA" {
+		t.Fatalf("CUDA classification changed: %s", got)
+	}
+}
+
+func TestCANNNativeProbePattern(t *testing.T) {
+	if runtime.GOOS != "linux" {
+		t.Skip("CANN requires Linux")
+	}
+	wanted := filepath.Join("cann", "libggml-cann.so")
+	for _, pattern := range nativeProbeBackendPatterns("cann") {
+		if pattern == wanted {
+			return
+		}
+	}
+	t.Fatal("CANN backend is absent from native probe patterns")
+}
+
+func TestCANNVisibleDeviceRemap(t *testing.T) {
+	t.Setenv("ASCEND_RT_VISIBLE_DEVICES", "2,5")
+	device := ml.DeviceInfo{DeviceID: ml.DeviceID{ID: "1", Library: "CANN"}}
+	remapFilterIDForUserVisibleDevices(&device)
+	if device.FilterID != "5" {
+		t.Fatalf("mapped to %q, want 5", device.FilterID)
+	}
+}
