new file mode 100644
index 0000000..bd4e81c
--- /dev/null
+++ b/ml/cann_test.go
@@ -0,0 +1,16 @@
+package ml
+
+import "testing"
+
+func TestCANNSelectedDeviceEnvironment(t *testing.T) {
+	env := map[string]string{}
+	for _, device := range []DeviceInfo{
+		{DeviceID: DeviceID{ID: "0", Library: "CANN"}, FilterID: "2"},
+		{DeviceID: DeviceID{ID: "1", Library: "CANN"}, FilterID: "5"},
+	} {
+		device.updateVisibleDevicesEnv(env, false)
+	}
+	if got := env["ASCEND_RT_VISIBLE_DEVICES"]; got != "2,5" {
+		t.Fatalf("selected devices %q, want 2,5", got)
+	}
+}
